COMPANY_NAME="Olffy"
SITE_NAME="Olffy"
SHOPIFY_REVALIDATION_SECRET=""
# Shopify Storefront / Headless - nombres oficiales del repo.
SHOPIFY_STORE_DOMAIN="tu-tienda-clienta.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Alias del frontend handoff.
SHOPIFY_STOREFRONT_TOKEN=""

# Alias usados por Vercel si ya existen en el proyecto.
SHOPIFY_s_SHOPIFY_STORE_DOMAIN=""
SHOPIFY_s_SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# En Vercel, los alias SHOPIFY_s_* tienen prioridad si existen.
# Mantener SHOPIFY_STORE_DOMAIN y SHOPIFY_STOREFRONT_ACCESS_TOKEN como nombres oficiales del repo.
# Nunca guardar valores reales en el repositorio.

# Usa este campo si tienes un token privado de Headless.
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=""
# Solo si estas usando un token publico de Storefront.
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=""
# Alias aceptado por compatibilidad si ya lo creaste en Vercel.
SHOPIFY_STORE_DOMINIO=""

# Admin API (para panel personalizado).
# Usar el dominio tecnico .myshopify.com de la tienda para Admin API.
SHOPIFY_ADMIN_STORE_DOMAIN="tu-tienda-clienta.myshopify.com"
# El POS requiere read_products, read_inventory, read_orders y write_orders.
# Los canjes requieren read_discounts y write_discounts.
# Opcion 1: access token Admin API real. No uses el Client Secret shpss_ aqui.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=""
# Alias del frontend handoff.
SHOPIFY_ADMIN_TOKEN=""
# Opcion 2: credenciales de una app propia instalada. El backend intercambia
# estas credenciales por un access token; nunca pongas el secret en el frontend.
SHOPIFY_ADMIN_API_CLIENT_ID=""
SHOPIFY_ADMIN_API_CLIENT_SECRET=""
SHOPIFY_ADMIN_API_VERSION="2026-04"
# Secreto del webhook orders/paid. Validar HMAC siempre en backend.
SHOPIFY_WEBHOOK_SECRET=""
ADMIN_PASSWORD="tu_contraseña"
# Firma la cookie del panel. Usa un valor largo, aleatorio y distinto.
ADMIN_SESSION_SECRET=""
# Alias aceptados por compatibilidad.
ADMIN_CONTRASENA=""
ADMIN_CONTRASEÑA=""

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
# Clave publica recomendada para proyectos nuevos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Alias legacy compatible con proyectos existentes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Solo backend. Recomendado para proyectos nuevos.
SUPABASE_SECRET_KEY=""
# Alias legacy compatible con proyectos existentes.
SUPABASE_SERVICE_ROLE_KEY=""

# URL publica canonica del sitio/tienda.
NEXT_PUBLIC_SITE_URL="https://olffy.cl"
SITE_URL="https://olffy.cl"
# NEXT_PUBLIC_SITE_URL tiene prioridad sobre VERCEL_PROJECT_PRODUCTION_URL para
# canonical URLs, sitemap y schema. En produccion configurar siempre con HTTPS
# y sin barra final. En desarrollo se usa http://localhost:3000 como fallback.

# Dominio de esta aplicacion Next.js, usado exclusivamente por los enlaces de
# confirmacion y recuperacion de clientes. Debe apuntar a una ruta donde existan
# /auth/confirm y /cuenta/restablecer; no uses el dominio Shopify si ambas apps
# viven en dominios distintos. En produccion no se usa el host de la peticion
# ni un dominio preview como fallback.
CUSTOMER_AUTH_SITE_URL="https://olffy.cl"

# Flujo transaccional OLFFY. Mantener deshabilitado hasta completar QA sandbox.
PAYMENTS_TUU_ENABLED="false"
TUU_REMOTE_POS_ENABLED="false"
DTE_PROVIDER="noop"
MARKETING_PROVIDER="noop"
OLFFY_DTE_MODE="always_issue_boleta"

# TUU online
TUU_ONLINE_ENV="sandbox"
TUU_ONLINE_ACCOUNT_ID=""
TUU_ONLINE_SECRET_KEY=""
TUU_ONLINE_API_URL=""
TUU_ONLINE_CALLBACK_URL=""
TUU_ONLINE_COMPLETE_URL=""
TUU_ONLINE_CANCEL_URL=""

# TUU POS / pago remoto
TUU_POS_API_KEY=""
TUU_POS_DEVICE_UUID=""
TUU_POS_DEVICE_SERIAL=""
TUU_POS_API_URL="https://integrations.payment.haulmer.com"
TUU_POS_CREATE_PATH="/RemotePayment/v2/Create"
TUU_POS_STATUS_PATH=""
TUU_POS_WEBHOOK_SECRET=""
TUU_POS_SOURCE_NAME="OLFFY Admin"
TUU_POS_SOURCE_VERSION="1.0.0"

# DTE / boleta electronica. No guardar XML o PDF en la base de datos.
DTE_API_URL=""
DTE_API_KEY=""
DTE_RUT_EMISOR=""
DTE_AMBIENTE="certificacion"
DTE_STORAGE_BUCKET="tax-documents"

# Email marketing
KLAVIYO_PRIVATE_API_KEY=""
KLAVIYO_LIST_ID=""
KLAVIYO_REVISION="2026-04-15"
MARKETING_CRON_SECRET=""

# Correo transaccional para consultas de soporte (SMTP / Google Workspace).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="Admin@olffy.cl"
SMTP_PASSWORD=""
SUPPORT_EMAIL_FROM="OLFFY <Admin@olffy.cl>"
# Direccion real para Reply-To y recepcion de respuestas.
SUPPORT_EMAIL_TO="Admin@olffy.cl"
# Vercel Cron envia este secreto automaticamente como Bearer token.
CRON_SECRET=""

# Rate limiting del login admin. En produccion usa Supabase como almacenamiento.
ADMIN_LOGIN_MAX_ATTEMPTS="5"
ADMIN_LOGIN_WINDOW_SECONDS="900"
