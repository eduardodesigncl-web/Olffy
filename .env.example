COMPANY_NAME="Olffy"
SITE_NAME="Olffy"
SHOPIFY_REVALIDATION_SECRET=""
# Shopify Storefront / Headless - nombres oficiales del repo.
SHOPIFY_STORE_DOMAIN="tu-tienda-clienta.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Alias usados por Vercel si ya existen en el proyecto.
SHOPIFY_s_SHOPIFY_STORE_DOMAIN=""
SHOPIFY_s_SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# En Vercel, los alias SHOPIFY_s_* tienen prioridad si existen.
# Mantener SHOPIFY_STORE_DOMAIN y SHOPIFY_STOREFRONT_ACCESS_TOKEN como nombres oficiales del repo.
# Nunca guardar valores reales en el repositorio.

# Usa este campo si tienes un token privado de Headless.
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=""
# Solo si estas usando un token publico de Storefront.
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=""
# Alias aceptado por compatibilidad si ya lo creaste en Vercel.
SHOPIFY_STORE_DOMINIO=""

# Admin API (para panel personalizado).
# El POS requiere read_products, read_inventory, read_orders y write_orders.
# Opcion 1: access token Admin directo.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=""
# Opcion 2: credenciales de una app propia instalada (recomendado).
SHOPIFY_ADMIN_API_CLIENT_ID=""
SHOPIFY_ADMIN_API_CLIENT_SECRET=""
SHOPIFY_ADMIN_API_VERSION="2026-04"
ADMIN_PASSWORD="tu_contraseña"
# Firma la cookie del panel. Usa un valor largo, aleatorio y distinto.
ADMIN_SESSION_SECRET=""
# Alias aceptados por compatibilidad.
ADMIN_CONTRASENA=""
ADMIN_CONTRASEÑA=""

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
# Clave publica recomendada para proyectos nuevos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Alias legacy compatible con proyectos existentes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Solo backend. Nunca exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
