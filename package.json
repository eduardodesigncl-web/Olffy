{
  "private": true,
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "env:check": "node scripts/validate-environment.mjs",
    "env:check:ci": "node scripts/validate-environment.mjs ci",
    "migrations:replay": "node scripts/replay-supabase-migrations.mjs",
    "migrations:verify": "node scripts/verify-supabase-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run typecheck && npm run prettier:check",
    "build:check": "npm run test && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
    "lucide-react": "^1.22.0",
    "next": "^16.2.9",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.0.14",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.14",
    "typescript": "5.8.2",
    "vitest": "^4.1.9"
  }
}
